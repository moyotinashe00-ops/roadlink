# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-separated origins allowed to call the API from a browser (React consoles).
# In production nothing is allowed unless you list it here (mobile apps are not affected by CORS).
# 5173-5177: hospital dashboard.  5180-5182: Reporter, Police and Ambulance apps run with `flutter run -d chrome --web-port 518x`.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5180,http://localhost:5181,http://localhost:5182

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/roadlink

# --- Auth ---
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
# Password given to seeded demo accounts (npm run db:seed). Development only.
SEED_PASSWORD=ChangeMe123!

# --- Incident handling ---
# Reject reports outside Zimbabwe's bounding box (spam protection).
# Leave false while developing: emulators report a US location by default.
GEOFENCE_ZW=false
# A new report within this radius of an open incident, inside the window, is merged into it.
DUPLICATE_RADIUS_M=150
DUPLICATE_WINDOW_MIN=30
# A vehicle position older than this is flagged stale and not preferred by auto-dispatch.
STALE_LOCATION_MIN=10
# If the alerted police unit has not accepted or declined within this time, the next nearest unit is alerted.
POLICE_ACK_TIMEOUT_MIN=3
ESCALATION_INTERVAL_SEC=30
# Per-IP limit on anonymous reports. Keep it generous: many phones can share one mobile-network address.
REPORT_RATE_LIMIT_PER_MIN=60
# Average ambulance speed (km/h) used for the built-in ETA estimate.
ETA_AVG_SPEED_KMH=35

# --- Push notifications (optional) ---
# Paste the Firebase service-account JSON on one line. Without it, pushes are logged instead of sent.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- USSD / SMS gateway ---
# Shared secret the gateway appends to the callback URL:  POST /api/v1/ussd?key=<secret>
USSD_SECRET=change-me

# --- Deployment ---
# Set to 1 behind a reverse proxy / PaaS so per-IP rate limits see real client addresses.
TRUST_PROXY=

# --- Uploads ---
UPLOAD_DIR=./uploads
