{
  "name": "roadlink-core",
  "version": "1.0.0",
  "description": "RoadLink Core \u2014 backend API, real-time and dispatch services for RoadLink ZW",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20.14"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/migrate.js --seed",
    "test": "node --test --test-force-exit --test-concurrency=1 tests/*.test.js",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "optionalDependencies": {
    "firebase-admin": "^14.5.0"
  }
}
